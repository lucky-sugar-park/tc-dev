# 로컬 개발용 환경 변수 예시. 실제 값은 .env에 쓰고 커밋하지 않는다

# --- tc (Tool Control, :8080) ---
# 비밀값 — 기본값 없음, 반드시 설정
TC_DB_PASSWORD=
TC_JWT_SECRET=
# 선택 — 비우면 application.yml 의 로컬 기본값을 쓴다
TC_SERVER_PORT=
TC_DB_URL=
TC_DB_USERNAME=
TC_REDIS_HOST=
TC_REDIS_PORT=
TC_TRUSTED_PROXIES=
TC_CORS_ALLOWED_ORIGIN_PATTERNS=
# tc 최초 관리자 — USER 표가 비어 있을 때만 쓴다. 해시는 BCrypt(평문 금지)
TC_BOOTSTRAP_ADMIN_ID=
TC_BOOTSTRAP_ADMIN_PASSWORD_HASH=

# --- vplc (가상 PLC, :8088) ---
# 비밀값 — 기본값 없음, 반드시 설정
VPLC_DB_PASSWORD=
# 선택
VPLC_DB_URL=
VPLC_DB_USERNAME=
